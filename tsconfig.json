{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Node20",
    "moduleResolution": "Node16",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "outDir": "dist",
    "verbatimModuleSyntax": true
  },
  "include": [
    "hardhat.config.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "final_versions/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "server"
  ]
}